{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Composite Design Library Schema",
  "description": "Unified specification for the 2-tier Atlas-Skill design model: macro art directions and composition blueprints with strict provenance and per-file item counts. Validated offline via Python standard-library validation tooling.",
  "version": "2.0.0",
  "type": "object",
  "required": ["version", "schema_type", "item_count", "items"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the unified dataset"
    },
    "schema_type": {
      "type": "string",
      "enum": ["art_directions", "compositions", "palettes", "typography", "sites", "app_shells"],
      "description": "Specific dataset type identifier"
    },
    "generated_at": {
      "type": "string",
      "description": "Optional ISO 8601 UTC timestamp of normalization run"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0,
      "description": "The exact number of records contained in this individual dataset file (len(items)). Global totals are calculated separately across files."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "name", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_:-]+$",
            "description": "Unique, stable, normalized identifier"
          },
          "layer": {
            "type": "string",
            "enum": ["art_direction", "composition", "palette", "typography", "site", "app_shell"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "required": ["source_project", "source_file", "source_id", "license", "attribution"],
            "properties": {
              "source_project": {
                "type": "string",
                "enum": ["taste-skill", "atlas-frontend-design", "project-atlas-v0.2.0-alpha"]
              },
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "description": "Mandatory attribution, copyright, or provenance statement"
              }
            }
          },
          "family": {
            "type": "string",
            "description": "Slot or layout family for compositions"
          },
          "page_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["marketing", "editorial", "app", "all"]
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "density": {
            "type": ["string", "null"],
            "enum": ["low", "med", "high", null]
          },
          "requires": {
            "type": "object",
            "properties": {
              "assets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "composition": {
            "type": ["string", "object", "array"]
          },
          "blueprint": {
            "type": ["array", "null"],
            "description": "DOM element structure for blueprint-based heroes and sections"
          },
          "responsive": {
            "type": ["string", "object", "null"]
          },
          "motion": {
            "type": ["string", "object", "null"]
          },
          "accessibility": {
            "type": ["string", "null"]
          },
          "avoid_when": {
            "type": ["array", "string", "null"]
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "incompatible": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seen_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
